# URL base de la API que usa el navegador.
# En desarrollo dejar "/api": Vite reenvia esas llamadas a API_PROXY_TARGET (sin problemas de CORS).
VITE_API_URL=/api

# Destino del proxy de desarrollo de Vite (donde corre dsw-api).
# Dentro de Docker, docker-compose.yml lo reemplaza por http://host.docker.internal:3000
API_PROXY_TARGET=http://localhost:3000
